{
  "name": "opencode-skill-usage",
  "version": "1.4.0",
  "description": "OpenCode v1/v2 plugin that records skill invocations and auto-registers a /skill-usage command for querying stats",
  "type": "module",
  "packageManager": "pnpm@8.11.0",
  "exports": {
    ".": "./plugin/index.js",
    "./plugin": "./plugin/index.js",
    "./server": "./plugin/index.js"
  },
  "files": [
    "plugin/",
    "skills/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/showlotus/opencode-skill-usage.git"
  },
  "homepage": "https://github.com/showlotus/opencode-skill-usage",
  "bugs": {
    "url": "https://github.com/showlotus/opencode-skill-usage/issues"
  },
  "author": "showlotus",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "skill",
    "usage",
    "tracking",
    "metrics"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.14.0",
    "@opencode/plugin": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opencode/plugin": {
      "optional": true
    }
  },
  "dependencies": {},
  "engines": {
    "node": ">=18"
  }
}
